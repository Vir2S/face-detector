LOG_LEVEL=INFO

# Provider switch
MINOR_GUARD_PROVIDER=opencv          # aws | sightengine | hive | opencv
MINOR_GUARD_FAIL_CLOSED=true      # if provider errors => block upload
MINOR_GUARD_STRICT=true           # stricter blocking logic where possible

# AWS Rekognition (DetectFaces -> AgeRange Low/High) :contentReference[oaicite:0]{index=0}
AWS_REGION=eu-central-1

# Sightengine (face-age -> attributes.age.minor prob) :contentReference[oaicite:1]{index=1}
SIGHTENGINE_API_USER=xxx
SIGHTENGINE_API_SECRET=yyy
SIGHTENGINE_MINOR_PROB_THRESHOLD=0.5

# Hive Demographic API (age classes include teenager/pre_teen/toddler/baby) :contentReference[oaicite:2]{index=2}
HIVE_API_KEY=zzz
HIVE_API_URL=https://api.thehive.ai/api/v2/task/sync
HIVE_MINOR_SCORE_THRESHOLD=0.5

# Optional tuning
OPENCV_FACE_CONF_TH=0.7
OPENCV_BLOCK_BUCKETS=(0-3),(4-7),(8-12),(13-20)
OPENCV_MODEL_DIR=models/opencv
OPENCV_DOWNLOAD_MODELS=true
